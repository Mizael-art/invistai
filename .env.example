# --- Supabase (autenticação e banco), lidas em runtime no servidor. Sem elas o app abre como visitante e o login informa "indisponível".
# Para permitir acesso antes da confirmação de e-mail, desative "Confirm email" em Auth → Providers → Email no painel do Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA use a service_role no frontend. Não é necessária nesta etapa.

# --- Dados de mercado (cripto spot via CoinGecko). Chave opcional (Demo API Key) — veja docs/ETAPA_01.md
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Forex (taxas diárias de referência do BCE via Frankfurter, sem chave)
FOREX_BASE_URL=https://api.frankfurter.dev/v1

# --- Notícias. Padrão sem chave: RSS público de fontes reais (Livecoins, Money Times, CoinDesk, Cointelegraph, investingLive),
# só manchete + link para a matéria original. NEWS_PROVIDER=newsapi (ou definir NEWS_API_KEY) usa a NewsAPI.
# NEWS_PROVIDER=rss
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2

# --- Limites (opcional)
# REGISTER_RATE_IP_PER_HOUR=10
# FORGOT_RATE_IP_PER_HOUR=10
# SEARCH_RATE_PER_MIN=30
# REFRESH_GLOBAL_PER_MIN=30

# --- Suporte (e-mail oficial; lido em runtime no servidor). Sem ele (ou com valor inválido/de exemplo), a página /suporte e o pedido de exclusão de conta ficam indisponíveis.
SUPPORT_EMAIL=

# --- Fuso dos horários exibidos (IANA). Padrão: America/Sao_Paulo.
# APP_TIMEZONE=America/Sao_Paulo

# --- Assinaturas (Etapa 1 do ecossistema) — Stripe. Sem estas variáveis, /assinatura mostra "pagamentos não configurados"
#     e nenhum plano pago é liberado. NUNCA coloque valores reais neste arquivo.
# STRIPE_SECRET_KEY=sk_live_...           # chave secreta (somente servidor)
# STRIPE_WEBHOOK_SECRET=whsec_...         # segredo do endpoint /api/billing/webhook
# STRIPE_PRICE_PRO=price_...              # preço mensal R$ 30,00 (BRL)
# STRIPE_PRICE_MAX=price_...              # preço mensal R$ 50,00 (BRL)
# BILLING_DB_SECRET=                      # ≥ 32 caracteres aleatórios; o banco guarda só o SHA-256 (billing_private.settings)
# APP_URL=https://seu-dominio             # base das URLs de retorno do Checkout/Portal

# --- TRADEON AI (Etapa 2). Sem chave, a página /ia avisa que a IA não está conectada e NENHUMA mensagem é descontada.
# AI_PROVIDER=openai                      # openai (ou qualquer API compatível com Chat Completions) | anthropic
# AI_API_KEY=                             # chave do provedor (somente servidor; nunca NEXT_PUBLIC_)
# AI_MODEL=gpt-4.1-mini                   # opcional; padrão por provedor
# AI_BASE_URL=                            # opcional (ex.: https://openrouter.ai/api/v1 para um provedor compatível)

# --- Motor de análise TRADEON (opcional): fonte pública de velas de cripto. Padrão: https://data-api.binance.vision/api/v3
# ENGINE_CRYPTO_BASE_URL=
# Exemplo com Gemini (plano gratuito, sem cartão — chave em aistudio.google.com):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_API_KEY=<chave do AI Studio>
#   AI_MODEL=<modelo Flash listado em Admin → Treinar IA → Testar conexão>
# IA reserva (opcional), usada automaticamente quando a principal atinge limite/cai — ex.: Groq (console.groq.com):
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=

# Cofre de credenciais de corretoras (AES-256-GCM). Gere: openssl rand -base64 32. Trocar invalida conexões existentes.
BROKER_ENC_KEY=
# Opcional (testes): BYBIT_BASE_URL, BINANCE_BASE_URL, BINANCE_FAPI_BASE_URL
